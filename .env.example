# Copy to .env and fill in. .env is gitignored; never commit it.

# --- App -------------------------------------------------------------------
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string
APP_NAME=ArXivMind
DEBUG=false
LOG_LEVEL=INFO

# --- Postgres (used by docker compose AND to build DATABASE_URL below) -----
# Use a password without special characters (it is embedded in a URL).
DB_USER=arxivmind
DB_PASSWORD=change-me
DB_NAME=arxivmind
DB_PORT=5433

# --- How the pipeline reaches the services ---------------------------------
# For running `python -m src.pipeline.runner` on YOUR machine (compose overrides these
# with the in-network hosts when the pipeline runs in a container).
# Keep user/password/port/name in step with the DB_* values above.
DATABASE_URL=postgresql+asyncpg://arxivmind:change-me@localhost:5433/arxivmind
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # only for a secured / cloud Qdrant
# QDRANT_COLLECTION=arxiv_papers_v2   # hybrid layout (dense + bm25). Changing the embedding model
#                                     # means a new name + `python -m src.pipeline.reindex --all`

# --- Accounts & free-tier limits (optional) ---------------------------------
# ADMIN_EMAILS='["you@example.com"]'   # exempt from limits
# ALLOW_REGISTRATION=true
# ACCESS_TOKEN_TTL_MINUTES=1440
# BCRYPT_ROUNDS=12
# RATE_LIMIT_PER_MINUTE=20
# FREE_DAILY_MESSAGES=50
# MEMORY_EMA_ALPHA=0.3
# MEMORY_DECAY_HALF_LIFE_DAYS=30

# --- Retrieval & chat (optional) --------------------------------------------
# MODEL_CACHE_DIR=data/models   # fastembed ONNX models (dense bge-small + BM25)
# RETRIEVAL_TOP_K=6             # sources per answer
# RETRIEVAL_MAX_PER_PAPER=3     # diversity cap
# ROUTER_USE_LLM=false          # true = LLM intent classifier (costs one call per message)
# LANGSMITH_TRACING=false       # true + LANGSMITH_API_KEY = traces sent to LangSmith cloud

# --- Ingestion (all optional; defaults live in src/core/config.py) ---------
# Use field prefixes and quoted phrases. Bare words are matched loosely by arXiv.
ARXIV_QUERY='(cat:cs.CL OR cat:cs.LG OR cat:cs.AI) AND abs:"large language models"'
ARXIV_MAX_RESULTS=5
# CACHE_DIR=data                # downloaded HTML/PDF are cached in <dir>/html and <dir>/pdf
# ARXIV_SORT_BY=submittedDate   # relevance | lastUpdatedDate | submittedDate
# ARXIV_REQUEST_DELAY_SECONDS=3.0

# --- API (only for the FastAPI service) ------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
